{
  "name": "obsidian-day-echo",
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "description": "Gather all your daily notes into one vertical timeline view.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "daily-notes",
    "timeline"
  ],
  "author": "tcyeee",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4",
    "vitest": "^4.1.8"
  }
}
