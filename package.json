{
  "name": "obsidian-day-echo",
  "version": "0.1.9",
  "packageManager": "pnpm@11.5.2",
  "description": "Turn scattered daily notes into one scrollable timeline — browse your journal by day, month, or year, jump to any entry in a click, and track mood or energy without losing the thread.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "daily-notes",
    "journal",
    "journaling",
    "timeline",
    "calendar",
    "diary"
  ],
  "author": "tcyeee",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4",
    "vitest": "^4.1.8"
  }
}
